        "random_irt_50": {"type": "baseline", "rank_distance": 11.1, "total_variation": 15.7, "saturation": 0.69},
        "random_irt_100":{"type": "baseline", "rank_distance": 10.6, "total_variation": 17.8, "saturation": 0.71},
        "random_irt_500":{"type": "baseline", "rank_distance": 8.4,  "total_variation": 10.9, "saturation": 0.85},
