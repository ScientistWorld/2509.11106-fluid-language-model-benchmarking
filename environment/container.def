# Apptainer definition file for FLUID BENCHMARKING environment.
#
# Build:  apptainer build container.sif container.def
#
# This is a CPU-only environment — no GPU needed for IRT computations.
#
# Using Red Hat UBI8 with Python — publicly accessible, no rate limits.

Bootstrap: docker
From: registry.access.redhat.com/ubi8/python-39:latest

%post
    # Install essential tools via microdnf (lightweight yum)
    microdnf install -y \
        vim-minimal \
        less \
        curl \
        wget \
        git \
        && microdnf clean all

    # Create working directory
    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1