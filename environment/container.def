# Robust CPU-only container for FLUID BENCHMARKING reproduction.
#
# Uses Ubuntu with Python and the small numerical stack installed via apt so
# the scheduler does not need to run a separate setup phase.

Bootstrap: docker
From: ubuntu:22.04

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgomp1 \
        python3 \
        python3-pip \
        python3-dev \
        python3-numpy \
        python3-pandas \
        python3-scipy \
    && rm -rf /var/lib/apt/lists/*

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
