# Apptainer definition file for FLUID BENCHMARKING environment.
#
# Build:  apptainer build container.sif container.def
#
# This is a CPU-only environment — no GPU needed for IRT computations.
#
# Use the Apptainer library transport to avoid OCI registry fetches.

Bootstrap: library
From: ubuntu:22.04

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        ca-certificates \
        less \
        curl \
        wget \
        git
    rm -rf /var/lib/apt/lists/*

    # Create working directory
    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
