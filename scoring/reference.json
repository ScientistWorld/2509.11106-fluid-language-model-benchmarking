{
  "experiments": {
    "ablation_comparison": {
      "description": "Ablation study comparing FLUID BENCHMARKING against RANDOM and RANDOM IRT baselines across different item counts. Results averaged across 6 benchmarks (ARC, GSM8K, HellaSwag, MMLU, TruthfulQA, WinoGrande), 6 LMs (Amber-6.7B, K2-65B, OLMo1-7B, OLMo2-7B, Pythia-2.8B, Pythia-6.9B), and 61-94 checkpoints per LM. Primary metric is validity (rank distance, lower is better).",
      "weight": 0.5,
      "primary_metric": "rank_distance",
      "metrics": {
        "rank_distance": {"higher_is_better": false, "coefficient": 1.0},
        "total_variation": {"higher_is_better": false, "coefficient": 0.8},
        "saturation": {"higher_is_better": true, "coefficient": 0.8}
      },
      "results": {
        "random_10":   {"type": "baseline", "rank_distance": 20.0, "total_variation": 29.0, "saturation": 0.47},
