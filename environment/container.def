# Lightweight container for FLUID BENCHMARKING CPU-only reproduction.
#
# Uses python:3.12-slim-bookworm as base (~45MB) with numerical libraries.

Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    set -e
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*



    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python dependencies for FLUID BENCHMARKING.
    # Uses uv for faster installation.
    
    set -euo pipefail
    
    if ! command -v uv >/dev/null 2>&1; then
        uv pip install --break-system-packages uv
    fi
    
    uv pip install --system numpy scipy pandas

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
