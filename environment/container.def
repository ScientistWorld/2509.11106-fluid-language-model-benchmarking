# Lightweight container for FLUID BENCHMARKING CPU-only reproduction.
#
# Uses python:3.12-slim-bookworm as base (~45MB) with numerical libraries.

Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    set -e
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgomp1 \
        libmpdec3 \
        libblas3 \
        liblapack3 \
    && rm -rf /var/lib/apt/lists/*

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
