# Apptainer definition file for FLUID BENCHMARKING environment.
#
# Build:  apptainer build container.sif container.def
#
# This is a CPU-only environment — no GPU needed for IRT computations.
#
# Use debootstrap to avoid OCI registry fetches entirely.

Bootstrap: debootstrap
OSVersion: bookworm
MirrorURL: http://deb.debian.org/debian/
Include: python3,python3-pip,ca-certificates,curl,wget,git,less

%post
    # Create working directory
    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
