# Lightweight container for FLUID BENCHMARKING CPU-only reproduction.
#
# Uses python:3.12-slim-bookworm as base (~45MB) with numerical libraries.

Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    set -e
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*




    # --- Frozen environment (5 packages) ---
    # Sources: 3 both, 2 overlay-only, 0 setup-only
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    uv pip install --system \
        'numpy==2.4.4' \
        'pandas==3.0.2' \
        'python_dateutil==2.9.0.post0' \
        'scipy==1.17.1' \
        'six==1.17.0'

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
