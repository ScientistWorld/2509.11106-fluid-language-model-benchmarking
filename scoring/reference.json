{
  "experiments": {
    "table2_ablation_comparison": {
      "description": "Primary comparison of the candidate efficient benchmarking strategy against matched subset baselines across item budgets 10, 50, 100, and 500. Results are averaged over 6 benchmarks, 6 LMs, and 61-94 checkpoints per LM.",
      "weight": 0.65,
      "primary_metric": "rank_distance",
      "metrics": {
        "rank_distance": {"higher_is_better": false, "coefficient": -1.0, "description": "Mean absolute rank deviation between paired benchmarks. Measures cross-benchmark validity: good selection should produce scores that rank LM abilities consistently across related benchmarks."},
        "total_variation": {"higher_is_better": false, "coefficient": -0.8, "description": "Normalized total variation of score curves across checkpoints. Measures score stability: good selection should produce smooth, non-oscillating score progressions."},
        "saturation": {"higher_is_better": true, "coefficient": 1.0, "description": "Pearson correlation between checkpoint index and score rank. Measures learning curve shape: good selection should show monotonic improvement (high saturation) rather than flat or noisy curves."}
      },
      "results": {
