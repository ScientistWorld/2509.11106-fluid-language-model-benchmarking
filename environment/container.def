# Apptainer definition file for FLUID BENCHMARKING environment.
#
# Build:  apptainer build container.sif container.def
#
# This is a CPU-only environment — no GPU needed for IRT computations.
#
# The container packages everything a scientist agent needs to work on
# this paper's task. The agent's workspace is bind-mounted at /home/user
# at runtime — it is NOT baked into the container.

Bootstrap: docker
From: debian:bookworm-slim

%post
    # Install Python and essential tools via apt
    # Using debian-slim to avoid Docker Hub Python image rate limits
    apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        tmux \
        nano \
        vim-tiny \
        less \
        curl \
        wget \
        git \
        && \
    ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

    # Create working directory
    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1