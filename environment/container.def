# Lightweight container for FLUID BENCHMARKING CPU-only reproduction.
#
# Uses python:3.12-slim-bookworm as base (~45MB) with numpy, scipy, pandas.

Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    set -e
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgomp1 \
        libmpdec3 \
        libblas3 \
        liblapack3 \
    && rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir \
        numpy \
        scipy \
        pandas

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PYTHONPATH="/home/user/.deps/fluid_benchmarking"
