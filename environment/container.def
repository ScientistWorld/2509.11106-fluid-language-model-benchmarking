# Apptainer definition file for FLUID BENCHMARKING environment.
#
# Build:  apptainer build container.sif container.def
#
# This is a CPU-only environment — no GPU needed for IRT computations.
#
# Using the official Python slim image to avoid flaky registry responses.

Bootstrap: docker
From: python:3.11-slim-bookworm

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        less \
        curl \
        wget \
        git \
    && rm -rf /var/lib/apt/lists/*

    # Create working directory
    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
