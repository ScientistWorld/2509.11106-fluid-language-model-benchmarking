        "random_50":     {"type": "baseline", "rank_distance": 15.2, "total_variation": 19.1, "saturation": 0.62},
        "random_100":    {"type": "baseline", "rank_distance": 16.9, "total_variation": 19.8, "saturation": 0.64},
