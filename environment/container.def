# Robust CPU-only container for FLUID BENCHMARKING evaluation.
#
# OS-level packages live here. The current evaluation submit does not need any
# additional Python packages beyond the standard library.

Bootstrap: docker
From: ubuntu:22.04

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgomp1 \
        python3 \
        python3-pip \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
