        "random_100":    {"type": "baseline", "rank_distance": 16.9, "total_variation": 19.8, "saturation": 0.64},
        "random_irt_10": {"type": "baseline", "rank_distance": 14.1, "total_variation": 18.2, "saturation": 0.48},
        "random_irt_50": {"type": "baseline", "rank_distance": 11.1, "total_variation": 15.7, "saturation": 0.69},
        "random_irt_100":{"type": "baseline", "rank_distance": 10.6, "total_variation": 17.8, "saturation": 0.71},
        "fluid_10":      {"type": "proposed",  "rank_distance": 10.1, "total_variation": 10.7, "saturation": 0.76},
        "fluid_50":      {"type": "proposed",  "rank_distance": 8.8,  "total_variation": 6.5,  "saturation": 0.86},
        "fluid_100":     {"type": "proposed",  "rank_distance": 8.7,  "total_variation": 6.1,  "saturation": 0.85}
      }
    }
