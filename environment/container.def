# Minimal Apptainer base for the CPU-only FLUID BENCHMARKING reproduction.
#
# The previous scratch-based build copied the host /usr tree and timed out.
# This variant relies on a small upstream Python image and leaves Python
# dependencies to environment/setup.sh.

Bootstrap: docker
From: python:3.11-slim

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1

